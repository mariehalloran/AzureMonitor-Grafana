{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Azure Cloud Native Monitoring",
  "id": "azure-monitor-app",
  "autoEnabled": true,
  "backend": true,
  "executable": "gpx_azure_cloudnative_monitoring",
  "info": {
    "keywords": ["app", "azure", "cloud", "native", "aks", "kubernetes", "monitoring", "health models", "cloudhealth"],
    "description": "Monitor your Azure Cloud Native services",
    "author": {
      "name": "Microsoft"
    },
    "logos": {
      "small": "img/azure logo.svg",
      "large": "img/azure logo.svg"
    },
    "screenshots": [
      {
        "name": "navbar",
        "path": "img/plugin_navbar.png"
      },
      {
        "name": "homepage",
        "path": "img/plugin_homepage.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "dashboard",
      "name": "Azure Health Models",
      "path": "dashboards/health-models.json",
      "addToNav": false
    },
    {
      "type": "datasource",
      "name": "Azure Health Models",
      "path": "datasources/health-models/plugin.json"
    },
    {
      "type": "panel",
      "name": "Azure Health Model Graph",
      "path": "panels/health-model-graph/plugin.json"
    },
    {
      "type": "panel",
      "name": "Azure Health Model Timeline",
      "path": "panels/health-model-timeline/plugin.json"
    },
    {
      "type": "page",
      "name": "Azure Cloud Native Monitoring",
      "path": "/a/%PLUGIN_ID%/clusternavigation",
      "role": "Admin",
      "addToNav": true,
      "defaultNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=10.4.0",
    "plugins": []
  }
}
